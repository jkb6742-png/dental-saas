// =============================================================================
// Import System Models (새로운 업로드 구조)
// =============================================================================

model ImportBatch {
  id           String         @id @default(cuid())
  clinicId     String
  year         Int
  status       String // PROCESSING, COMPLETED, FAILED
  totalFiles   Int            @default(0)
  successFiles Int            @default(0)
  failedFiles  Int            @default(0)
  uploadedBy   String
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  errorMessage String?
  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  files        ImportedFile[]

  @@index([clinicId, year])
  @@index([status])
}

model ImportedFile {
  id             String           @id @default(cuid())
  batchId        String
  clinicId       String
  originalName   String
  filePath       String?
  fileSize       Int
  checksum       String?
  detectedType   String // FileCategory 값
  detectedBy     DetectionMethod
  confidence     Float?
  year           Int
  month          Int? // 0이면 연간 데이터
  status         FileStatus       @default(PENDING)
  sheetName      String?
  headerRowIndex Int?
  columnMapping  String? // JSON string
  recordCount    Int              @default(0)
  errorCount     Int              @default(0)
  warnings       String? // JSON array
  errors         String? // JSON array
  createdAt      DateTime         @default(now())
  processedAt    DateTime?
  batch          ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  rowErrors      ImportRowError[]

  @@index([clinicId, year, month])
  @@index([status])
  @@index([detectedType])
}

model ImportRowError {
  id             String       @id @default(cuid())
  importedFileId String
  rowNumber      Int
  fieldName      String?
  rawValue       String?
  message        String
  createdAt      DateTime     @default(now())
  importedFile   ImportedFile @relation(fields: [importedFileId], references: [id], onDelete: Cascade)

  @@index([importedFileId, rowNumber])
}

model ApiIntegration {
  id              String      @id @default(cuid())
  provider        ApiProvider
  name            String
  encryptedApiKey String
  model           String?
  isEnabled       Boolean     @default(true)
  isDefault       Boolean     @default(false)
  lastTestedAt    DateTime?
  lastTestStatus  String? // SUCCESS, FAILED
  lastTestMessage String?
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isEnabled, isDefault])
  @@index([provider])
}

// =============================================================================
// 요청사항 (원장님 → THINKLAB 작업 요청: 이미지 제작·원고·홈페이지 수정 등)
// =============================================================================

enum ServiceRequestCategory {
  IMAGE // 이미지·디자인 제작
  CONTENT // 블로그·칼럼·SNS 원고
  WEBSITE // 홈페이지 수정
  REPORT // 보고서·데이터 요청
  ADS // 광고·마케팅
  OTHER // 기타 문의
}

enum ServiceRequestStatus {
  REQUESTED // 접수
  IN_REVIEW // 검토중
  IN_PROGRESS // 진행중
  DONE // 완료
  CANCELED // 취소
}

enum ServiceRequestPriority {
  HIGH
  MEDIUM
  LOW
}

model ServiceRequest {
  id          String                     @id @default(cuid())
  clinicId    String
  category    ServiceRequestCategory
  title       String
  description String
  details     Json? // 카테고리별 세부 입력값(용도·사이즈·문구·URL 등)
  status      ServiceRequestStatus       @default(REQUESTED)
  priority    ServiceRequestPriority     @default(MEDIUM)
  dueDate     DateTime?
  assignee    String? // 담당자 표시명(THINKLAB 내부)
  resultNote  String? // 완료 시 결과 안내
  completedAt DateTime?
  createdBy   String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  clinic      Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        User                       @relation("ServiceRequestCreator", fields: [createdBy], references: [id])
  comments    ServiceRequestComment[]
  attachments ServiceRequestAttachment[]

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@index([status, createdAt])
}

model ServiceRequestComment {
  id        String         @id @default(cuid())
  requestId String
  content   String
  createdBy String
  createdAt DateTime       @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [createdBy], references: [id])

  @@index([requestId, createdAt])
}

model ServiceRequestAttachment {
  id           String         @id @default(cuid())
  requestId    String
  fileName     String // 저장 파일명
  originalName String
  fileSize     Int
  mimeType     String
  filePath     String // uploads/requests/... 상대경로
  kind         String         @default("REFERENCE") // REFERENCE(요청 참고) | RESULT(결과물)
  uploadedBy   String
  uploadedAt   DateTime       @default(now())
  request      ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [uploadedBy], references: [id])

  @@index([requestId])
}

// =============================================================================
// 네이버 검색광고 API 연동 (치과별 광고계정)
// =============================================================================

model NaverAdAccount {
  id              String    @id @default(cuid())
  clinicId        String    @unique
  customerId      String // 네이버 검색광고 CUSTOMER_ID
  apiKey          String // 액세스 라이선스
  secretKey       String // 비밀키
  isActive        Boolean   @default(true)
  lastSyncAt      DateTime?
  lastSyncStatus  String? // SUCCESS | FAILED
  lastSyncError   String?
  // 알림 설정
  alertEnabled    Boolean   @default(false) // 비즈머니 부족 메일 알림
  alertThreshold  Int       @default(100000) // 이 금액(원) 이하로 떨어지면 알림
  alertDays       Int? // 설정 시 '최근 7일 일평균 × N일' 이하로 떨어지면 알림(금액 기준 대신)
  alertThreshold2 Int? // 2차 기준(원). 금액 기준일 때만. 1차보다 작아야 함
  alertEmails     String? // 수신 메일(쉼표 구분)
  alertOnSyncFail Boolean   @default(true) // 동기화 실패도 메일로
  lastAlertAt     DateTime? // 마지막 부족 알림 발송 시각
  lastAlertLevel  Int       @default(0) // 0 없음 · 1 1차 발송됨 · 2 2차 발송됨. 잔액이 1차 기준 위로 올라오면 0으로 초기화
  lastBizmoney    Int? // 마지막 조회 잔액(원)
  lastBizmoneyAt  DateTime?
  autoMonthlyReport Boolean @default(false) // 매월 1일 전월 보고서 자동 생성
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// 캠페인별 일자별 성과 (impCnt·clkCnt·salesAmt 등)
model NaverAdDailyStat {
  id           String   @id @default(cuid())
  clinicId     String
  date         DateTime @db.Date
  campaignId   String
  campaignName String
  campaignType String?
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  cost         Int      @default(0) // 원(VAT 별도)
  avgRank      Float?
  conversions  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date, campaignId])
  @@index([clinicId, date])
}

// 네이버 검색광고 운영 보고서 (기간 지정 → 수치 집계 + GPT 해석 → HTML 저장)
model NaverAdReport {
  id           String   @id @default(cuid())
  clinicId     String
  title        String
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  compareStart DateTime @db.Date
  compareEnd   DateTime @db.Date
  memo         String? // 생성 시 전달한 운영 메모(미송출·결정 사항 등)
  status       String   @default("DONE") // GENERATING | DONE | FAILED
  error        String?
  model        String? // 사용한 GPT 모델
  summary      Json? // 핵심 수치(목록 표시용)
  html         String? // 완성된 보고서 HTML
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

// 앱 내 알림(헤더 종 아이콘). 수신자(User) 단위로 한 행씩 만든다
model Notification {
  id        String    @id @default(cuid())
  userId    String
  clinicId  String?
  type      String // NAVER_BIZMONEY | NAVER_SYNC_FAIL | NAVER_REPORT | REQUEST_NEW | REQUEST_STATUS | REQUEST_COMMENT | SYSTEM
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

// PEI(환자경험지수) 자체 설문 — 구글폼 대체. 치과별 공개 링크(/s/<token>)로 응답을 받는다.
model PeiSurvey {
  id                String        @id @default(cuid())
  clinicId          String        @unique
  token             String        @unique
  slug              String?       @unique // 한글 주소 /하얀드림치과설문 (기본값 = 치과명 공백 제거 + "설문")
  title             String
  intro             String?
  slogan            String? // 제목 아래 한 줄 — "○○○, 하얀드림치과입니다"
  logo              String? // 맨 위 치과 로고 URL (업로드)
  doctors           Json // {name, photo}[] — name "이름 원장 (전공 전문의)" (예전 string[] 도 읽음)
  treatments        Json          @default("[]") // string[] — 3번 받은 진료 선택지
  questions         Json          @default("[]") // QuestionDef[] — 문항 구성(순서·문구·선택지·필수). 비어 있으면 기본 15문항
  facilityQuestion  String
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  clinic            Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  responses         PeiResponse[]
}

model PeiResponse {
  id          String    @id @default(cuid())
  surveyId    String
  clinicId    String
  year        Int
  month       Int
  submittedAt DateTime  @default(now())
  visitType   String? // 첫 방문 / 재방문
  gender      String?
  ageGroup    String?
  doctor      String?
  treatments  Json? // string[] — 받은 진료 (중복 선택)
  answers     Json? // { c_xxxx: 값 } — 관리자가 직접 더한 문항 응답
  // 4~12번 문항: 1~5, 0 = 경험 없음
  qPhone      Int?
  qDesk       Int?
  qConsult    Int?
  qDoctorTalk Int?
  qHygienist  Int?
  qDoctorCare Int?
  qFacility   Int?
  qHomepage   Int?
  qWaiting    Int?
  recommend   Int? // 0~10
  positive    String?
  improvement String?
  ipHash      String?
  survey      PeiSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, year, month])
  @@index([surveyId, submittedAt])
}

// 홈페이지(그누보드) 상담문의 연동. 사이트의 /dashboard/api/leads.php 를 토큰으로 읽어 온다(읽기 전용).
model SiteLeadSource {
  id             String     @id @default(cuid())
  clinicId       String     @unique
  siteUrl        String // https://dearsdental.com
  token          String // protect() 로 암호화 저장
  isActive       Boolean    @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus String? // SUCCESS | FAILED
  lastSyncError  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  clinic         Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  leads          SiteLead[]
}

// 상담문의 1건 = 사이트 g5_track_leads 1행. 접수 1년 지나면 삭제(개인정보 보관기간)
model SiteLead {
  id            String         @id @default(cuid())
  clinicId      String
  sourceId      String
  siteLeadId    Int // g5_track_leads.id
  boTable       String
  wrId          Int
  receivedAt    DateTime // 사이트 접수 시각
  siteUpdatedAt DateTime?
  status        String // new · contacted · consulting · booked · visited · hold · lost · spam
  statusLabel   String?
  name          String?
  phone         String?
  category      String?
  subject       String?
  channel       String? // quick_form · counsel_form · contact_form
  path          String?
  src           String?
  srcLabel      String?
  med           String?
  medLabel      String?
  campaign      String?
  noteCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  source        SiteLeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, siteLeadId])
  @@index([clinicId, receivedAt])
}
