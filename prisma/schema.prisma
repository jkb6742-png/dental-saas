generator client {
  provider      = "prisma-client-js"
  // NAS(ARM64 alpine, OpenSSL 3) 런타임용 엔진을 반드시 함께 생성.
  // 미지정 시 빌더가 openssl 감지 실패로 1.1.x 엔진을 만들어 런타임에서 libssl.so.1.1 없음 오류 발생.
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      PlanTier @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinics   Clinic[]
  users     User[]
}

model User {
  id                     String                     @id @default(cuid())
  email                  String                     @unique
  password               String
  name                   String
  role                   UserRole                   @default(VIEWER)
  agencyId               String
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  approvedAt             DateTime?
  approvedBy             String?
  inviteCodeId           String?
  status                 UserStatus                 @default(PENDING)
  lockedAt               DateTime?
  lockUntil              DateTime?
  // 직접 소속 치과. 비마스터(로그인 계정)는 이 치과에만 접근 가능. MASTER는 null.
  clinicId               String?
  clinic                 Clinic?                    @relation("ClinicAccounts", fields: [clinicId], references: [id], onDelete: Cascade)
  actionPlans            ActionPlan[]
  actionPlanAttachments  ActionPlanAttachment[]
  actionPlanComments     ActionPlanComment[]
  createdInviteCodes     InviteCode[]               @relation("InviteCodeCreator")
  generatedPeiReports    PeiReport[]                @relation("PeiReportGenerator")
  peiSheetConfigs        PeiSheetConfig[]
  serviceRequests        ServiceRequest[]           @relation("ServiceRequestCreator")
  serviceRequestComments ServiceRequestComment[]
  serviceRequestFiles    ServiceRequestAttachment[]
  agency                 Agency                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  inviteCode             InviteCode?                @relation(fields: [inviteCodeId], references: [id])
}

model Clinic {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String
  agencyId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  actionPlans           ActionPlan[]
  ageDatas              AgeData[]
  ageDists              AgeDist[]
  agency                Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  consultationStats     ConsultationStat[]
  dailyLedgers          DailyLedger[]
  dataProcessingRecords DataProcessingRecord[]
  fileUploads           FileUpload[]
  implantStats          ImplantStat[]
  inviteCodes           InviteCode[]
  monthlySummaries      MonthlySummary[]
  patientConsents       PatientConsent[]
  patientInfos          PatientInfo[]
  patientStats          PatientStat[]
  peiReports            PeiReport[]
  peiSheetConfig        PeiSheetConfig?
  peiSurvey             PeiSurvey?
  peiResponses          PeiResponse[]
  receptionRecords      ReceptionRecord[]
  regionDatas           RegionData[]
  regionDists           RegionDist[]
  reports               Report[]
  reportSectors         ReportSector[]
  managedReports        ManagedReport[]
  revenues              Revenue[]
  revenueGoals          RevenueGoal[]
  reviews               Review[]
  reviewConfigs         ReviewConfig[]
  reviewSummaries       ReviewSummary[]
  treatmentDatas        TreatmentData[]
  treatmentPlans        TreatmentPlan[]
  treatmentStats        TreatmentStat[]
  uploadLogs            UploadLog[]
  visitRoutes           VisitRoute[]
  visitRouteDatas       VisitRouteData[]
  importBatches         ImportBatch[]
  importedFiles         ImportedFile[]
  clinicAccounts        User[]                 @relation("ClinicAccounts")
  cashRevenues          CashRevenue[]
  serviceRequests       ServiceRequest[]
  naverAdAccount        NaverAdAccount?
  naverAdStats          NaverAdDailyStat[]
  naverAdReports        NaverAdReport[]
  siteLeadSource        SiteLeadSource?
  siteLeads             SiteLead[]

  @@unique([agencyId, code])
}

// 마스터가 월별로 직접 입력하는 현금매출. 총매출에 가산됨.
model CashRevenue {
  id        String   @id @default(cuid())
  clinicId  String
  year      Int
  month     Int
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month])
  @@index([clinicId, year, month])
}

model DailyLedger {
  id             String   @id @default(cuid())
  clinicId       String
  date           DateTime
  month          Int
  year           Int
  cashIncome     Float?
  cardIncome     Float?
  onlineIncome   Float?
  receiptIssued  Float?
  insuranceClaim Float?
  cashExpense    Float?
  cardExpense    Float?
  onlineExpense  Float?
  cardFee        Float?
  totalIncome    Float?
  totalExpense   Float?
  netTotal       Float?
  createdAt      DateTime @default(now())
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, year, month])
}

model MonthlySummary {
  id                    String   @id @default(cuid())
  clinicId              String
  year                  Int
  month                 Int
  totalRevenue          Float?
  totalExpense          Float?
  netProfit             Float?
  cashIncome            Float?
  cardIncome            Float?
  insuranceClaim        Float?
  nonInsuranceRevenue   Float?
  newPatients           Int?
  totalPatients         Int?
  workingDays           Int?
  avgDailyRevenue       Float?
  newPatientRevenue     Float?
  revisitRate           Float?
  nonInsuranceRatio     Float?
  revenueGrowth         Float?
  newPatientGrowth      Float?
  totalArrears          Float?
  arrearsRate           Float?
  treatmentCompleteRate Float?
  avgWaitingTime        Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  totalBilledRevenue    Float?
  clinic                Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  report                Report?

  @@unique([clinicId, year, month])
  @@index([clinicId, year])
}

model PatientStat {
  id                   String   @id @default(cuid())
  clinicId             String
  date                 DateTime
  month                Int
  year                 Int
  workingDays          Float?
  newPatients          Float?
  totalVisits          Float?
  totalAppointments    Float?
  avgDailyNewPatients  Float?
  avgDailyAppointments Float?
  createdAt            DateTime @default(now())
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, year, month])
}

model TreatmentStat {
  id           String            @id @default(cuid())
  clinicId     String
  year         Int
  month        Int
  itemName     String
  category     TreatmentCategory
  patientCount Float?
  visitCount   Float?
  revenue      Float?
  visitRatio   Float?
  revenueRatio Float?
  periodType   PeriodType        @default(MONTHLY)
  source       DataSource        @default(OFFICIAL_EXCEL)
  createdAt    DateTime          @default(now())
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, itemName, source])
  @@index([clinicId, year, month])
  @@index([source, periodType])
}

model VisitRoute {
  id                String   @id @default(cuid())
  clinicId          String
  year              Int
  month             Int
  routeName         String
  totalVisitors     Float?
  returningPatients Float?
  newPatients       Float?
  totalVisits       Float?
  avgRevenue        Float?
  totalRevenue      Float?
  acquisitionCost   Float?
  createdAt         DateTime @default(now())
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, routeName])
  @@index([clinicId, year, month])
}

model TreatmentPlan {
  id              String           @id @default(cuid())
  clinicId        String
  patientName     String
  chartNumber     String?
  writtenDate     DateTime?
  lastVisit       DateTime?
  nextAppointment DateTime?
  status          TreatmentStatus?
  paymentStatus   PaymentStatus?
  doctor          String?
  counselor       String?
  planContent     String?
  contractAmount  Float?
  remainingAmount Float?
  month           Int?
  year            Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, year, month])
  @@index([clinicId, paymentStatus])
}

model Report {
  id               String          @id @default(cuid())
  clinicId         String
  monthlySummaryId String?         @unique
  year             Int
  month            Int
  content          String?
  pdfUrl           String?
  generatedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clinic           Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  monthlySummary   MonthlySummary? @relation(fields: [monthlySummaryId], references: [id])

  @@unique([clinicId, year, month])
}

// 치과별 보고서 카테고리(섹터). 마스터가 치과마다 자유롭게 등록/정렬.
// (기존 배포 DB의 ReportSector 테이블과 1:1 매핑 — 구조 변경 금지)
model ReportSector {
  id        String          @id @default(cuid())
  clinicId  String
  name      String
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  clinic    Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  reports   ManagedReport[]

  @@index([clinicId])
}

// 마스터가 업로드하는 HTML 보고서. 카테고리(섹터)에 소속.
// (기존 배포 DB의 ManagedReport 테이블과 1:1 매핑 — month는 String)
model ManagedReport {
  id        String       @id @default(cuid())
  clinicId  String
  sectorId  String
  title     String
  content   String // HTML: sanitize된 원본 / PDF: 빈 문자열
  fileType  String       @default("html") // "html" | "pdf"
  fileName  String? // 원본 파일명(PDF)
  fileData  Bytes? // PDF 바이너리(bytea). DB에 저장돼 백업/이관에 함께 따라감
  month     String?
  memo      String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  clinic    Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  sector    ReportSector @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([sectorId])
}

model ImplantStat {
  id           String   @id @default(cuid())
  clinicId     String
  year         Int
  month        Int
  fixtureName  String
  surgeryCount Float?
  usageCount   Float?
  createdAt    DateTime @default(now())
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, fixtureName])
  @@index([clinicId, year, month])
}

model ConsultationStat {
  id                 String     @id @default(cuid())
  clinicId           String
  year               Int
  month              Int
  counselorName      String
  planCount          Float?
  confirmedCount     Float?
  confirmationRate   Float?
  patientCount       Float?
  confirmedPatients  Float?
  patientConfirmRate Float?
  confirmedAmount    Float?
  avgDiscountRate    Float?
  periodType         PeriodType @default(MONTHLY)
  source             DataSource @default(OFFICIAL_EXCEL)
  createdAt          DateTime   @default(now())
  clinic             Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, counselorName, source])
  @@index([clinicId, year, month])
  @@index([source, periodType])
}

model ReceptionRecord {
  id                 String    @id @default(cuid())
  clinicId           String
  year               Int
  month              Int
  receptionTime      DateTime?
  status             String?
  chartNumber        String?
  patientName        String?
  ageGender          String?
  insuranceType      String?
  patientType        String? // 신환/구환
  identityVerified   String?
  waitingMinutes     Int? // 분 단위 대기시간
  treatmentStartTime DateTime?
  treatmentEndTime   DateTime?
  reservationTime    DateTime?
  doctor             String?
  treatmentDoctor    String?
  summaryDoctor      String?
  paymentStaff       String?
  chair              String?
  phone              String?
  treatmentMemo      String? // 진료/예약내역
  totalRevenue       Float?
  insuranceCoverage  Float? // 공단부담
  patientPayment     Float? // 본인부담
  nonInsurance       Float? // 비급여
  vat                Float? // 부가세
  discountAmount     Float? // 할인액
  cardPayment        Float?
  cashPayment        Float?
  onlinePayment      Float? // 기타(온라인)
  receiptIssued      String? // 현영
  healthExpense      Float? // 건강생활비
  dailyArrears       Float?
  totalArrears       Float?
  memo               String?
  firstVisitDate     DateTime? // 최초내원
  visitRoute         String? // 내원경로
  customerTendency   String? // 고객성향
  customerType       String? // 고객구분
  customerType2      String? // 고객구분2
  recallType         String? // 리콜구분
  createdAt          DateTime  @default(now())
  waitingTime        Float? // 기존 호환성을 위해 유지
  clinic             Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, year, month])
  @@index([clinicId, patientType])
  @@index([clinicId, doctor])
  @@index([clinicId, chartNumber])
  @@index([clinicId, visitRoute])
  @@index([clinicId, receptionTime])
}

model AgeDist {
  id                String     @id @default(cuid())
  clinicId          String
  year              Int
  month             Int?
  ageGroup          String
  totalPatients     Float?
  returningPatients Float?
  newPatients       Float?
  avgRevenue        Float?
  periodType        PeriodType @default(MONTHLY)
  source            DataSource @default(OFFICIAL_EXCEL)
  createdAt         DateTime   @default(now())
  clinic            Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, ageGroup, source])
  @@index([clinicId, year, month])
  @@index([source, periodType])
}

model RegionDist {
  id                String     @id @default(cuid())
  clinicId          String
  year              Int
  month             Int?
  region            String
  totalPatients     Float?
  returningPatients Float?
  newPatients       Float?
  totalVisits       Float?
  avgRevenue        Float?
  periodType        PeriodType @default(MONTHLY)
  source            DataSource @default(OFFICIAL_EXCEL)
  createdAt         DateTime   @default(now())
  clinic            Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, region, source])
  @@index([clinicId, year, month])
  @@index([source, periodType])
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdBy   String
  usedBy      String?
  usedAt      DateTime?
  expiresAt   DateTime?
  maxUses     Int       @default(1)
  currentUses Int       @default(0)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  creator     User      @relation("InviteCodeCreator", fields: [createdBy], references: [id])
  users       User[]

  @@index([clinicId, isActive])
  @@index([code])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  clinicId  String?
  agencyId  String?
  ip        String?
  details   Json?
  timestamp DateTime @default(now())
  severity  String   @default("MEDIUM")

  @@index([userId, timestamp])
  @@index([event, timestamp])
  @@index([clinicId, timestamp])
}

model PeiSheetConfig {
  id         String      @id @default(cuid())
  clinicId   String      @unique
  sheetUrl   String
  sheetId    String
  sheetName  String?
  isActive   Boolean     @default(true)
  lastSyncAt DateTime?
  createdBy  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  reports    PeiReport[]
  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [createdBy], references: [id])

  @@index([clinicId, isActive])
}

model PeiReport {
  id              String          @id @default(cuid())
  clinicId        String
  sheetConfigId   String?
  year            Int
  month           Int
  title           String?
  summary         String?
  insights        Json?
  recommendations Json?
  rawData         Json?
  peiScore        Float?
  categoryScores  Json?
  content         String?
  pdfUrl          String?
  status          String          @default("GENERATING")
  generatedAt     DateTime?
  generatedBy     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  generator       User            @relation("PeiReportGenerator", fields: [generatedBy], references: [id])
  sheetConfig     PeiSheetConfig? @relation(fields: [sheetConfigId], references: [id])

  @@unique([clinicId, year, month])
  @@index([clinicId, status])
  @@index([generatedAt])
}

model ReviewConfig {
  id         String           @id @default(cuid())
  clinicId   String
  source     ReviewSource
  placeName  String?
  placeId    String?
  placeUrl   String?
  isActive   Boolean          @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reviews    Review[]
  snapshots  ReviewSnapshot[]
  clinic     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, source])
  @@index([clinicId, isActive])
}

model Review {
  id         String       @id @default(cuid())
  clinicId   String
  configId   String
  source     ReviewSource
  reviewId   String
  authorName String?
  rating     Int?
  content    String?
  reviewDate DateTime?
  reply      String?
  replyDate  DateTime?
  originType String?
  replyDraft String?
  analyzedAt DateTime?
  isPositive Boolean?
  keywords   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  config     ReviewConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, reviewId])
  @@index([clinicId, source, reviewDate])
  @@index([clinicId, rating])
}

// 수집 시점마다 플레이스 전체 리뷰 수를 남겨 월별 신규 = (월말 총계 - 전월말 총계)로 계산
model ReviewSnapshot {
  id           String       @id @default(cuid())
  configId     String
  visitorTotal Int
  blogTotal    Int?
  takenAt      DateTime     @default(now())
  config       ReviewConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, takenAt])
}

model ReviewSummary {
  id              String       @id @default(cuid())
  clinicId        String
  source          ReviewSource
  year            Int
  month           Int
  totalReviews    Int          @default(0)
  newReviews      Int          @default(0)
  avgRating       Float?
  positiveCount   Int          @default(0)
  negativeCount   Int          @default(0)
  replyRate       Float?
  topKeywords     Json?
  ratingDist      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  achievementRate Float?
  targetReviews   Int?
  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, source, year, month])
  @@index([clinicId, year, month])
}

model MedicalAccessLog {
  id             String   @id @default(cuid())
  userId         String
  action         String
  resourceType   String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())
  additionalData Json?
  severity       String   @default("MEDIUM")

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([resourceType, timestamp])
  @@index([severity, timestamp])
}

model PatientConsent {
  id          String    @id @default(cuid())
  patientId   String
  clinicId    String
  consentType String
  consented   Boolean   @default(false)
  consentDate DateTime  @default(now())
  expiryDate  DateTime?
  revokedDate DateTime?
  consentText String?
  version     String    @default("1.0")
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([patientId, clinicId, consentType])
  @@index([clinicId, consentType])
  @@index([expiryDate])
}

model DataProcessingRecord {
  id                String    @id @default(cuid())
  clinicId          String
  processingType    String
  dataCategory      String
  purpose           String
  legalBasis        String
  dataSubject       String?
  retentionPeriod   String?
  thirdPartySharing Boolean   @default(false)
  encryptionUsed    Boolean   @default(true)
  processingDate    DateTime  @default(now())
  completedDate     DateTime?
  status            String    @default("ACTIVE")
  description       String?
  createdAt         DateTime  @default(now())
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, processingType])
  @@index([processingDate])
  @@index([status])
}

model RevenueGoal {
  id             String   @id @default(cuid())
  clinicId       String
  year           Int
  month          Int?
  goalType       String
  revenueGoal    Float
  newPatientGoal Int?
  description    String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month])
  @@index([clinicId, year])
  @@index([goalType])
}

model FileUpload {
  id           String       @id @default(cuid())
  clinicId     String
  category     FileCategory
  fileName     String
  originalName String
  filePath     String
  fileSize     Int
  year         Int
  month        Int?
  uploadedAt   DateTime     @default(now())
  processedAt  DateTime?
  status       FileStatus   @default(PENDING)
  checksum     String
  recordCount  Int?
  errorMessage String?
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, category, year, month])
  @@index([clinicId, year, month])
}

model UploadLog {
  id        String       @id @default(cuid())
  clinicId  String
  action    String
  fileName  String
  category  FileCategory
  year      Int
  month     Int?
  status    String
  message   String?
  createdAt DateTime     @default(now())
  clinic    Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

model ActionPlan {
  id          String                 @id @default(cuid())
  clinicId    String
  goal        String
  description String
  targetDate  DateTime
  status      ActionPlanStatus       @default(PENDING)
  priority    ActionPlanPriority     @default(MEDIUM)
  progress    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdBy   String
  clinic      Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user        User                   @relation(fields: [createdBy], references: [id])
  attachments ActionPlanAttachment[]
  comments    ActionPlanComment[]

  @@index([clinicId, status])
  @@index([clinicId, createdAt])
}

model ActionPlanAttachment {
  id           String     @id @default(cuid())
  actionPlanId String
  fileName     String
  originalName String
  fileSize     Int
  mimeType     String
  filePath     String
  uploadedAt   DateTime   @default(now())
  uploadedBy   String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [uploadedBy], references: [id])

  @@index([actionPlanId])
}

model ActionPlanComment {
  id           String     @id @default(cuid())
  actionPlanId String
  content      String
  createdAt    DateTime   @default(now())
  createdBy    String
  actionPlan   ActionPlan @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [createdBy], references: [id])

  @@index([actionPlanId, createdAt])
}

model Revenue {
