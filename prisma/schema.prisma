generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agency {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      PlanTier @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinics   Clinic[]
  users     User[]
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  password            String
  name                String
  role                UserRole         @default(VIEWER)
  agencyId            String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  approvedAt          DateTime?
  approvedBy          String?
  inviteCodeId        String?
  status              UserStatus       @default(PENDING)
  lockedAt            DateTime?
  lockUntil           DateTime?
  createdInviteCodes  InviteCode[]     @relation("InviteCodeCreator")
  generatedPeiReports PeiReport[]      @relation("PeiReportGenerator")
  peiSheetConfigs     PeiSheetConfig[]
  agency              Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  inviteCode          InviteCode?      @relation(fields: [inviteCodeId], references: [id])
}

model Clinic {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String
  agencyId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  ageDists              AgeDist[]
  agency                Agency                 @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  consultationStats     ConsultationStat[]
  dailyLedgers          DailyLedger[]
  dataProcessingRecords DataProcessingRecord[]
  fileUploads           FileUpload[]
  implantStats          ImplantStat[]
  inviteCodes           InviteCode[]
  monthlySummaries      MonthlySummary[]
  patientConsents       PatientConsent[]
  patientStats          PatientStat[]
  peiReports            PeiReport[]
  peiSheetConfig        PeiSheetConfig?
  receptionRecords      ReceptionRecord[]
  regionDists           RegionDist[]
  reports               Report[]
  revenueGoals          RevenueGoal[]
  reviews               Review[]
  reviewConfigs         ReviewConfig[]
  reviewSummaries       ReviewSummary[]
  treatmentPlans        TreatmentPlan[]
  treatmentStats        TreatmentStat[]
  uploadLogs            UploadLog[]
  visitRoutes           VisitRoute[]

  // 새로운 6개 핵심 데이터 관계
  revenues              Revenue[]
  patientInfos          PatientInfo[]
  treatmentDatas        TreatmentData[]
  visitRouteDatas       VisitRouteData[]
  regionDatas           RegionData[]
  ageDatas              AgeData[]

  @@unique([agencyId, code])
}

model DailyLedger {
  id             String   @id @default(cuid())
  clinicId       String
  date           DateTime
  month          Int
  year           Int
  cashIncome     Float?
  cardIncome     Float?
  onlineIncome   Float?
  receiptIssued  Float?
  insuranceClaim Float?
  cashExpense    Float?
  cardExpense    Float?
  onlineExpense  Float?
  cardFee        Float?
  totalIncome    Float?
  totalExpense   Float?
  netTotal       Float?
  createdAt      DateTime @default(now())
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, year, month])
}

model MonthlySummary {
  id                    String   @id @default(cuid())
  clinicId              String
  year                  Int
  month                 Int
  totalRevenue          Float?
  totalExpense          Float?
  netProfit             Float?
  cashIncome            Float?
  cardIncome            Float?
  insuranceClaim        Float?
  nonInsuranceRevenue   Float?
  newPatients           Int?
  totalPatients         Int?
  workingDays           Int?
  avgDailyRevenue       Float?
  newPatientRevenue     Float?
  revisitRate           Float?
  nonInsuranceRatio     Float?
  revenueGrowth         Float?
  newPatientGrowth      Float?
  totalArrears          Float?
  arrearsRate           Float?
  treatmentCompleteRate Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  totalBilledRevenue    Float?
  clinic                Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  report                Report?

  @@unique([clinicId, year, month])
  @@index([clinicId, year])
}

model PatientStat {
  id                   String   @id @default(cuid())
  clinicId             String
  date                 DateTime
  month                Int
  year                 Int
  workingDays          Float?
  newPatients          Float?
  totalVisits          Float?
  totalAppointments    Float?
  avgDailyNewPatients  Float?
  avgDailyAppointments Float?
  createdAt            DateTime @default(now())
  clinic               Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, year, month])
}

model TreatmentStat {
  id           String            @id @default(cuid())
  clinicId     String
  year         Int
  month        Int
  itemName     String
  category     TreatmentCategory
  patientCount Float?
  visitCount   Float?
  revenue      Float?
  visitRatio   Float?
  revenueRatio Float?
  createdAt    DateTime          @default(now())
  clinic       Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, itemName])
  @@index([clinicId, year, month])
}

model VisitRoute {
  id                String   @id @default(cuid())
  clinicId          String
  year              Int
  month             Int
  routeName         String
  totalVisitors     Float?
  returningPatients Float?
  newPatients       Float?
  totalVisits       Float?
  avgRevenue        Float?
  totalRevenue      Float?
  acquisitionCost   Float?
  createdAt         DateTime @default(now())
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, routeName])
  @@index([clinicId, year, month])
}

model TreatmentPlan {
  id              String           @id @default(cuid())
  clinicId        String
  patientName     String
  chartNumber     String?
  writtenDate     DateTime?
  lastVisit       DateTime?
  nextAppointment DateTime?
  status          TreatmentStatus?
  paymentStatus   PaymentStatus?
  doctor          String?
  counselor       String?
  planContent     String?
  contractAmount  Float?
  remainingAmount Float?
  month           Int?
  year            Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clinic          Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, year, month])
  @@index([clinicId, paymentStatus])
}

model Report {
  id               String          @id @default(cuid())
  clinicId         String
  monthlySummaryId String?         @unique
  year             Int
  month            Int
  content          String?
  pdfUrl           String?
  generatedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clinic           Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  monthlySummary   MonthlySummary? @relation(fields: [monthlySummaryId], references: [id])

  @@unique([clinicId, year, month])
}

model ImplantStat {
  id           String   @id @default(cuid())
  clinicId     String
  year         Int
  month        Int
  fixtureName  String
  surgeryCount Float?
  usageCount   Float?
  createdAt    DateTime @default(now())
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, fixtureName])
  @@index([clinicId, year, month])
}

model ConsultationStat {
  id                 String   @id @default(cuid())
  clinicId           String
  year               Int
  month              Int
  counselorName      String
  planCount          Float?
  confirmedCount     Float?
  confirmationRate   Float?
  patientCount       Float?
  confirmedPatients  Float?
  patientConfirmRate Float?
  confirmedAmount    Float?
  avgDiscountRate    Float?
  createdAt          DateTime @default(now())
  clinic             Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, counselorName])
  @@index([clinicId, year, month])
}

model ReceptionRecord {
  id                String    @id @default(cuid())
  clinicId          String
  year              Int
  month             Int
  receptionTime     DateTime?
  status            String?
  chartNumber       String?
  patientName       String?
  ageGender         String?
  insuranceType     String?
  patientType       String?
  doctor            String?
  totalRevenue      Float?
  insuranceCoverage Float?
  patientPayment    Float?
  nonInsurance      Float?
  cardPayment       Float?
  cashPayment       Float?
  onlinePayment     Float?
  dailyArrears      Float?
  totalArrears      Float?
  visitRoute        String?
  createdAt         DateTime  @default(now())
  waitingTime       Float?
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, year, month])
  @@index([clinicId, patientType])
  @@index([clinicId, doctor])
}

model AgeDist {
  id                String   @id @default(cuid())
  clinicId          String
  year              Int
  month             Int
  ageGroup          String
  totalPatients     Float?
  returningPatients Float?
  newPatients       Float?
  avgRevenue        Float?
  createdAt         DateTime @default(now())
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, ageGroup])
  @@index([clinicId, year, month])
}

model RegionDist {
  id                String   @id @default(cuid())
  clinicId          String
  year              Int
  month             Int
  region            String
  totalPatients     Float?
  returningPatients Float?
  newPatients       Float?
  totalVisits       Float?
  avgRevenue        Float?
  createdAt         DateTime @default(now())
  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month, region])
  @@index([clinicId, year, month])
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  createdBy   String
  usedBy      String?
  usedAt      DateTime?
  expiresAt   DateTime?
  maxUses     Int       @default(1)
  currentUses Int       @default(0)
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinicId    String
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  creator     User      @relation("InviteCodeCreator", fields: [createdBy], references: [id])
  users       User[]

  @@index([clinicId, isActive])
  @@index([code])
}

model SecurityLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  clinicId  String?
  agencyId  String?
  ip        String?
  details   Json?
  timestamp DateTime @default(now())
  severity  String   @default("MEDIUM")

  @@index([userId, timestamp])
  @@index([event, timestamp])
  @@index([clinicId, timestamp])
}

model PeiSheetConfig {
  id         String      @id @default(cuid())
  clinicId   String      @unique
  sheetUrl   String
  sheetId    String
  sheetName  String?
  isActive   Boolean     @default(true)
  lastSyncAt DateTime?
  createdBy  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  reports    PeiReport[]
  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  creator    User        @relation(fields: [createdBy], references: [id])

  @@index([clinicId, isActive])
}

model PeiReport {
  id              String          @id @default(cuid())
  clinicId        String
  sheetConfigId   String?
  year            Int
  month           Int
  title           String?
  summary         String?
  insights        Json?
  recommendations Json?
  rawData         Json?
  peiScore        Float?
  categoryScores  Json?
  content         String?
  pdfUrl          String?
  status          String          @default("GENERATING")
  generatedAt     DateTime?
  generatedBy     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clinic          Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  generator       User            @relation("PeiReportGenerator", fields: [generatedBy], references: [id])
  sheetConfig     PeiSheetConfig? @relation(fields: [sheetConfigId], references: [id])

  @@unique([clinicId, year, month])
  @@index([clinicId, status])
  @@index([generatedAt])
}

model ReviewConfig {
  id         String       @id @default(cuid())
  clinicId   String
  source     ReviewSource
  placeName  String?
  placeId    String?
  placeUrl   String?
  isActive   Boolean      @default(true)
  lastSyncAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reviews    Review[]
  snapshots  ReviewSnapshot[]
  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, source])
  @@index([clinicId, isActive])
}

model Review {
  id         String       @id @default(cuid())
  clinicId   String
  configId   String
  source     ReviewSource
  reviewId   String
  authorName String?
  rating     Int?
  content    String?
  reviewDate DateTime?
  reply      String?
  replyDate  DateTime?
  originType String?
  replyDraft String?
  analyzedAt DateTime?
  isPositive Boolean?
  keywords   Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  clinic     Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  config     ReviewConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, reviewId])
  @@index([clinicId, source, reviewDate])
  @@index([clinicId, rating])
}

// 수집 시점마다 플레이스 전체 리뷰 수를 남겨 월별 신규 = (월말 총계 - 전월말 총계)로 계산
model ReviewSnapshot {
  id           String       @id @default(cuid())
  configId     String
  visitorTotal Int
  blogTotal    Int?
  takenAt      DateTime     @default(now())
  config       ReviewConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId, takenAt])
}

model ReviewSummary {
  id              String       @id @default(cuid())
  clinicId        String
  source          ReviewSource
  year            Int
  month           Int
  totalReviews    Int          @default(0)
  newReviews      Int          @default(0)
  avgRating       Float?
  positiveCount   Int          @default(0)
  negativeCount   Int          @default(0)
  replyRate       Float?
  topKeywords     Json?
  ratingDist      Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  achievementRate Float?
  targetReviews   Int?
  clinic          Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, source, year, month])
  @@index([clinicId, year, month])
}

model MedicalAccessLog {
  id             String   @id @default(cuid())
  userId         String
  action         String
  resourceType   String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())
  additionalData Json?
  severity       String   @default("MEDIUM")

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([resourceType, timestamp])
  @@index([severity, timestamp])
}

model PatientConsent {
  id          String    @id @default(cuid())
  patientId   String
  clinicId    String
  consentType String
  consented   Boolean   @default(false)
  consentDate DateTime  @default(now())
  expiryDate  DateTime?
  revokedDate DateTime?
  consentText String?
  version     String    @default("1.0")
  ipAddress   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([patientId, clinicId, consentType])
  @@index([clinicId, consentType])
  @@index([expiryDate])
}

model DataProcessingRecord {
  id                String    @id @default(cuid())
  clinicId          String
  processingType    String
  dataCategory      String
  purpose           String
  legalBasis        String
  dataSubject       String?
  retentionPeriod   String?
  thirdPartySharing Boolean   @default(false)
  encryptionUsed    Boolean   @default(true)
  processingDate    DateTime  @default(now())
  completedDate     DateTime?
  status            String    @default("ACTIVE")
  description       String?
  createdAt         DateTime  @default(now())
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, processingType])
  @@index([processingDate])
  @@index([status])
}

model RevenueGoal {
  id             String   @id @default(cuid())
  clinicId       String
  year           Int
  month          Int?
  goalType       String
  revenueGoal    Float
  newPatientGoal Int?
  description    String?
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, year, month])
  @@index([clinicId, year])
  @@index([goalType])
}

model FileUpload {
  id           String       @id @default(cuid())
  clinicId     String
  category     FileCategory
  fileName     String
  originalName String
  filePath     String
  fileSize     Int
  year         Int
  month        Int?
  uploadedAt   DateTime     @default(now())
  processedAt  DateTime?
  status       FileStatus   @default(PENDING)
  checksum     String
  recordCount  Int?
  errorMessage String?
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, category, year, month])
  @@index([clinicId, year, month])
}

model UploadLog {
  id        String       @id @default(cuid())
  clinicId  String
  action    String
  fileName  String
  category  FileCategory
  year      Int
  month     Int?
  status    String
  message   String?
  createdAt DateTime     @default(now())
  clinic    Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
  MASTER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum TreatmentStatus {
  IN_PROGRESS
  COMPLETED
  PENDING
  ON_HOLD
}

enum PaymentStatus {
  COMPLETED
  INCOMPLETE
  NA
}

enum TreatmentCategory {
  INSURANCE
  NON_INSURANCE
}

enum ReviewSource {
  NAVER
  GOOGLE
}

enum FileCategory {
  MONTHLY_LEDGER
  ANNUAL_LEDGER
  TREATMENT_STATS
  IMPLANT_STATS
  COMPREHENSIVE_PATIENTS
  AGE_DISTRIBUTION
  REGION_DISTRIBUTION
  DAILY_PATIENTS
  VISIT_ROUTES
}

enum FileStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

// ========================================
// 새로운 6개 핵심 데이터 테이블
// ========================================

// 1. 💰 매출 데이터 (일별)
model Revenue {
  id            String   @id @default(cuid())
  clinicId      String
  date          DateTime
  year          Int
  month         Int
  day           Int

  cashIncome    Float    @default(0)    // 현금수입
  cardIncome    Float    @default(0)    // 카드수입
  onlineIncome  Float    @default(0)    // 온라인수입
  totalIncome   Float    @default(0)    // 총수입
  totalExpense  Float    @default(0)    // 총지출
  netProfit     Float    @default(0)    // 순이익

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, date])
  @@index([clinicId, year, month])
}

// 2. 👥 환자정보 데이터 (방문별)
model PatientInfo {
  id              String   @id @default(cuid())
  clinicId        String
  chartNumber     String
  name            String
  age             Int?
  gender          String?
  region          String?
  visitRoute      String?

  visitDate       DateTime
  visitTime       String?
  receptionTime   DateTime?
  visitType       String             // 신환/구환
  ageGroup        String?            // 20대, 30대 등

  waitingTime     Int      @default(0) // 대기시간(분)
  revenue         Float    @default(0) // 진료비
  treatmentType   String?             // 임플란트, 보철 등

  year            Int
  month           Int
  day             Int

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, chartNumber])
  @@index([clinicId, year, month])
  @@index([clinicId, visitType])
  @@index([clinicId, region])
  @@index([clinicId, visitRoute])
}

// 3. 🦷 진료별 데이터 (월별 집계)
model TreatmentData {
  id              String   @id @default(cuid())
  clinicId        String
  treatmentType   String            // 임플란트, 보철, 교정 등
  year            Int
  month           Int

  patientCount    Int      @default(0) // 환자수
  totalRevenue    Float    @default(0) // 총매출
  avgRevenue      Float    @default(0) // 평균 진료비

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, treatmentType, year, month])
  @@index([clinicId, year, month])
}

// 4. 🛣️ 내원경로 데이터 (월별 집계)
model VisitRouteData {
  id                String   @id @default(cuid())
  clinicId          String
  routeName         String            // 지인소개, 인터넷 등
  year              Int
  month             Int

  newPatients       Int      @default(0) // 신환수
  returningPatients Int      @default(0) // 구환수
  totalRevenue      Float    @default(0) // 총매출

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinic            Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, routeName, year, month])
  @@index([clinicId, year, month])
}

// 5. 📍 지역별 데이터 (월별 집계)
model RegionData {
  id            String   @id @default(cuid())
  clinicId      String
  region        String            // 강남구, 서초구 등
  year          Int
  month         Int

  patientCount  Int      @default(0) // 환자수
  percentage    Float    @default(0) // 비율

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, region, year, month])
  @@index([clinicId, year, month])
}

// 6. 👶👴 연령 데이터 (월별 집계)
model AgeData {
  id            String   @id @default(cuid())
  clinicId      String
  ageGroup      String            // 20대, 30대 등
  year          Int
  month         Int

  patientCount  Int      @default(0) // 환자수
  percentage    Float    @default(0) // 비율

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clinic        Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, ageGroup, year, month])
  @@index([clinicId, year, month])
}
