# 빌드 컨텍스트에서 제외 (ARM 빌드 오염/비대화 방지)
# node_modules: 로컬(Windows/x64)이 ARM 빌드 node_modules를 덮어써 네이티브 모듈이 깨지는 것 방지 — deps 스테이지에서 npm ci로 새로 설치됨
node_modules
.next
.git
.gitignore

# 대용량/불필요 산출물
*.tar
# 로컬 비밀값 파일은 이미지에 넣지 않는다 (운영 값은 NAS 의 .env 를 --env-file 로 주입). Next standalone 이 .env 를 복사하므로 반드시 제외
.env
.env.*
!.env.example
*.sql
# 단, 마이그레이션 SQL 은 운영의 /api/requests/init-db 가 읽으므로 이미지에 포함
!prisma/migrations/**/*.sql
uploads
.env.nas-backup

# 잡파일
npm-debug.log*
yarn-error.log*
.DS_Store
.vscode
.idea
*.tar.gz
*.zip
ops/
ops-july2026/
scripts/
uploads/
cache/
logs/

# NAS 배포 인수인계(이미지 tar·env 보강값 포함)
handoff/
